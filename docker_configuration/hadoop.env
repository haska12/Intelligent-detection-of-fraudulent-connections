# ─────────────────────────────────────────
# GENERAL HADOOP CONFIG
# ─────────────────────────────────────────
HADOOP_HOME=/opt/hadoop
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:9000
CORE-SITE.XML_fs.default.name=hdfs://namenode:9000

# ─────────────────────────────────────────
# HDFS CONFIGURATION
# ─────────────────────────────────────────
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:9000
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.permissions=false

# CRITICAL: Fix for Windows/External Access
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.address=0.0.0.0:9866
HDFS-SITE.XML_dfs.datanode.http.address=0.0.0.0:9864

# ─────────────────────────────────────────
# YARN CONFIGURATION
# ─────────────────────────────────────────
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=2048
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=2048
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle

# ─────────────────────────────────────────
# MAPREDUCE CONFIGURATION
# ─────────────────────────────────────────
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_mapreduce.application.classpath=$HADOOP_HOME/share/hadoop/mapreduce/*:$HADOOP_HOME/share/hadoop/mapreduce/lib/*